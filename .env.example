COMPOSE_PROJECT_NAME=evdp
POSTGRES_DB=evdp
POSTGRES_USER=evdp
POSTGRES_PASSWORD=evdp_local_postgres_password
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://evdp:evdp_local_postgres_password@postgres:5432/evdp
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=evdp-local-session-secret-change-before-production
COOKIE_SECURE=false
REDIS_PASSWORD=evdp_local_redis_password
REDIS_URL=redis://:evdp_local_redis_password@redis:6379/0
RABBITMQ_DEFAULT_USER=evdp
RABBITMQ_DEFAULT_PASS=evdp_local_rabbitmq_password
RABBITMQ_URL=amqp://evdp:evdp_local_rabbitmq_password@rabbitmq:5672
MINIO_ROOT_USER=evdp_local_minio
MINIO_ROOT_PASSWORD=evdp_local_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=evdp_local_minio
MINIO_SECRET_KEY=evdp_local_minio_password
QDRANT_URL=http://qdrant:6333
QWEN_API_KEY=
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_QUALITY_CONCURRENCY=2
AI_QUALITY_MODEL_TIMEOUT_MS=600000
VIDEO_QUALITY_PROMPT_PATH=/quality/qwen-video-ai-quality-prompt-v1.md
VIDEO_QUALITY_INITIAL_MODEL=qwen3.7-plus
VIDEO_QUALITY_REVIEW_MODEL=qwen3.7-flash
QUALITY_LAB_HOST=127.0.0.1
QUALITY_LAB_PORT=4010
QUALITY_LAB_MAX_UPLOAD_BYTES=1073741824
QUALITY_LAB_MODEL_TIMEOUT_MS=600000
QUALITY_LAB_HISTORY_PATH=/data/quality-lab/jobs.json
QUALITY_LAB_HISTORY_RETENTION_DAYS=30
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
BACKEND_INTERNAL_URL=http://api:4000/api/v1
